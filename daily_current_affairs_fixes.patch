+    if when not in {"1d", "2d", "3d", "5d", "7d", "14d", "30d"}:
+        when = "2d"
+    query = quote(f"site:{domain} when:{when}", safe="")
+    return f"https://news.google.com/rss/search?q={query}&hl=en-IN&gl=IN&ceid=IN:en"
