# =============================================================================
# AGRI LEARNING POINT — Daily Current Affairs
# Environment Configuration Template
# =============================================================================
# Copy this file to `.env` and fill in the real values:
#   cp .env.example .env
#
# NEVER commit the real `.env` file — it contains secrets.
# For GitHub Actions, add each secret under:
#   Settings → Secrets and variables → Actions → New repository secret
# =============================================================================

# -----------------------------------------------------------------------------
# 🔴 REQUIRED — Telegram Bot
# -----------------------------------------------------------------------------
# Bot token from @BotFather
TELEGRAM_BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ

# Target channel/group ID. Format options:
#   @channel_name          — public channel
#   -1001234567890         — private channel (numeric)
#   -1234567890            — group
TELEGRAM_CHAT_ID=@your_channel_here

# Message parse mode: HTML | MarkdownV2 | (empty for plain)
TELEGRAM_PARSE_MODE=HTML

# Max PDFs to publish per run (safety cap)
TELEGRAM_MAX_PER_RUN=5

# Pin verifier: unpin previous message before pinning new one?
#   0 = keep old pins (multiple pinned messages)
#   1 = unpin old, keep only latest pinned
TELEGRAM_UNPIN_OLD=0

# Pin verifier: send a small "📌 Pinned" notify message to channel?
TELEGRAM_PIN_NOTIFY=1

# Pin verifier: retries for verification
TELEGRAM_PIN_VERIFY_RETRIES=3

# -----------------------------------------------------------------------------
# 🟡 OPTIONAL — LLM / AI Providers
# -----------------------------------------------------------------------------
# If empty, pipeline runs in heuristic-only mode (no AI verification/polish).
# Leave blank to disable AI entirely.

# OpenAI-compatible endpoint (OpenAI, Groq, OpenRouter, etc.)
LLM_API_URL=https://api.openai.com/v1/chat/completions
LLM_API_KEY=sk-your-key-here
LLM_MODEL=gpt-4o-mini

# Alternative: direct OpenAI (used by content polish)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

# Alternative: Google Gemini (primary in ai_router fallback chain)
GEMINI_API_KEY=
GOOGLE_API_KEY=

# Alternative: Groq (fast fallback)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Alternative: OpenRouter (fallback; account credits may be required)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini

# Alternative: Mistral (final fallback)
MISTRAL_API_KEY=

# Alternative: NVIDIA NIM (final fallback; keep the key in a secret manager)
NVIDIA_API_KEY=
NVIDIA_MODEL=meta/llama-3.3-70b-instruct

# -----------------------------------------------------------------------------
# 🟢 PIPELINE BEHAVIOR
# -----------------------------------------------------------------------------

# --- Fact Verification ---
# Minimum confidence score (0.0–1.0) for an article to pass verification.
# Lower = more permissive (more articles pass, but noise possible)
# Higher = strict (fewer articles, higher quality)
# Recommended: 0.25–0.4
MIN_CONFIDENCE_THRESHOLD=0.3

# Minimum number of verified items required to proceed.
# If fewer than this pass, the job fails.
# Set to 1 for daily runs (was hardcoded 5 previously)
MIN_VERIFIED_COUNT=1

# Disable LLM verification entirely (use heuristics only)
#   1 = heuristics only (fast, free)
#   0 = use LLM if configured
ALP_DISABLE_LLM_VERIFY=0

# Disable English content polish step
#   1 = never call polish API
ALP_DISABLE_POLISH=0

# Strict translation mode — if AI translation fails, use raw English
# instead of dictionary fallback.
#   1 = fail-closed (no dictionary Hindi shipped)
#   0 = allow dictionary fallback with needs_review flag
ALP_TRANSLATION_STRICT=0

# Translation provider timeout (seconds)
ALP_TRANSLATION_TIMEOUT=45

# Translation max retries per provider
ALP_TRANSLATION_MAX_RETRIES=2

# Translation LRU cache size (number of strings)
ALP_TRANSLATION_CACHE_SIZE=2000

# -----------------------------------------------------------------------------
# 🟢 COLLECTION BEHAVIOR
# -----------------------------------------------------------------------------
# Per-request timeout (seconds)
REQUEST_TIMEOUT=30

# Max retries per source
MAX_RETRIES=3

# Concurrent workers for parallel feed fetching
MAX_WORKERS=8

# Max response size from a single feed (bytes). Prevents memory blowup.
MAX_RESPONSE_BYTES=5242880

# Max articles extracted per source
MAX_ARTICLES_PER_SOURCE=100

# Override sources config file path (optional)
# NEWS_SOURCES_FILE=config/news_sources.json

# -----------------------------------------------------------------------------
# 🟢 ORCHESTRATOR
# -----------------------------------------------------------------------------
# Timeout per stage (seconds). Kill hung processes.
STAGE_TIMEOUT_SECONDS=900

# Max retries per stage (transient failures)
MAX_STAGE_RETRIES=3

# Watchdog: hours after which a RUNNING job is considered stuck
WATCHDOG_STUCK_HOURS=2

# Logging verbosity: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# -----------------------------------------------------------------------------
# 🟢 MEMORY & STATE
# -----------------------------------------------------------------------------
# Override importance-memory file location
# ALP_MEMORY_PATH=state/importance_memory.json

# Max entries in importance memory before trimming
ALP_MEMORY_MAX_ENTRIES=2000

# Root directory override (used by pipeline/state.py)
# ALP_ROOT=/path/to/repo

# -----------------------------------------------------------------------------
# 🟢 TESTING / DEVELOPMENT ONLY
# -----------------------------------------------------------------------------
# Dry-run mode — skip actual Telegram publishing
DRY_RUN=0

# Override date for testing
# TEST_DATE=2026-10-14

# =============================================================================
# GitHub Actions Setup
# =============================================================================
# Add these as Repository Secrets (Settings → Secrets → Actions):
#
#   TELEGRAM_BOT_TOKEN        ← required for publishing
#   TELEGRAM_CHAT_ID          ← required for publishing
#   LLM_API_URL               ← optional; enable AI features
#   LLM_API_KEY               ← optional
#   LLM_MODEL                 ← optional
#
# Pipeline behavior vars (MIN_CONFIDENCE_THRESHOLD, etc.) can be added
# as Repository Variables instead of Secrets — they aren't sensitive:
#
#   Settings → Secrets and variables → Actions → Variables → New variable
#
# =============================================================================
# Quick Reference — What Each Var Controls
# =============================================================================
# ┌────────────────────────────┬─────────────────────────────────────────┐
# │ Variable                   │ Effect if unset/missing                 │
# ├────────────────────────────┼─────────────────────────────────────────┤
# │ TELEGRAM_BOT_TOKEN         │ Publish stage FAILS                     │
# │ TELEGRAM_CHAT_ID           │ Publish stage FAILS                     │
# │ LLM_API_KEY                │ Heuristic-only verification, no polish  │
# │ MIN_CONFIDENCE_THRESHOLD   │ Defaults to 0.3                         │
# │ MIN_VERIFIED_COUNT         │ Defaults to 1 (was 5)                   │
# │ STAGE_TIMEOUT_SECONDS      │ Defaults to 900s (15 min)               │
# │ WATCHDOG_STUCK_HOURS       │ Defaults to 2h                          │
# │ DRY_RUN                    │ Defaults to 0 (real publish)            │
# └────────────────────────────┴─────────────────────────────────────────┘
# =============================================================================

# Manual, operator-approved correction only. Scheduled workflows keep this off.
# Does NOT bypass uncertain sends; those require receipt reconciliation first.
ALP_ALLOW_EDITION_REVISION=0
GEMINI_MODEL=gemini-flash-latest
OPENROUTER_MODEL=openai/gpt-4o-mini
