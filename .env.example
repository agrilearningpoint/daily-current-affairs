# =============================================================================
# AGRI LEARNING POINT — Daily Current Affairs
# Environment Configuration Template
# =============================================================================
# Copy this file to `.env` and fill in the real values:
#   cp .env.example .env
#
# NEVER commit the real `.env` file — it contains secrets.
# For GitHub Actions, add each secret under:
#   Settings → Secrets and variables → Actions → New repository secret
#
# NOTE: Every name below is exactly the name the code reads (verified against
# os.getenv / os.environ.get calls). Legacy aliases are called out explicitly.
# =============================================================================

# -----------------------------------------------------------------------------
# 🔴 REQUIRED — Telegram Bot (publishing stages only)
# -----------------------------------------------------------------------------
# Bot token from @BotFather. Placeholder only — replace with the real token.
TELEGRAM_BOT_TOKEN=replace_with_your_botfather_token

# Target channel/group ID. Format options:
#   @channel_name          — public channel
#   -1001234567890         — private channel (numeric)
#   -1234567890            — group
TELEGRAM_CHAT_ID=@your_channel_here

# Watchdog alert recipient (Telegram user/chat id). Required only for alerts.
ADMIN_ID=

# Message parse mode: HTML | MarkdownV2 | (empty for plain)
TELEGRAM_PARSE_MODE=HTML

# Max PDFs to publish per run (safety cap)
TELEGRAM_MAX_PER_RUN=5

# Pin verifier: unpin previous message before pinning new one?
#   0 = keep old pins (multiple pinned messages)
#   1 = unpin old, keep only latest pinned
TELEGRAM_UNPIN_OLD=0

# Pin verifier: send a small "📌 Pinned" notify message to channel?
TELEGRAM_PIN_NOTIFY=1

# Pin verifier: retries for verification
TELEGRAM_PIN_VERIFY_RETRIES=3

# -----------------------------------------------------------------------------
# 🟡 OPTIONAL — LLM / AI Providers
# -----------------------------------------------------------------------------
# If none are set, the pipeline runs in heuristic-only mode
# (no AI verification / polish / translation).

# Every *_MODEL accepts "auto": the router reads the provider's live model
# catalogue and picks the first free model from pipeline/ai_router.py
# _PREFERRED_MODELS, so a retired model never breaks the pipeline.

# Google Gemini (primary in the ai_router fallback chain)
GEMINI_API_KEY=
GOOGLE_API_KEY=
GEMINI_MODEL=auto

# Groq (fast fallback)
GROQ_API_KEY=
GROQ_MODEL=auto

# Pollinations (https://text.pollinations.ai/openai, OpenAI-compatible).
# Verified 2026-11-10: the token is NOT recognised — every auth method (Bearer,
# "token" header, ?token=) answers "user_tier": "anonymous", exactly like a bogus
# key, so the anonymous IP limit applies (1 reply / 45 s, then HTTP 402
# FREE_LIMIT → provider out for the run). Activate/subscribe the key on
# enter.pollinations.ai, then raise AI_ROUTER_RPD_POLLINATIONS.
POLLINATIONS_API_KEY=
POLLINATIONS_BASE_URL=https://text.pollinations.ai/openai
POLLINATIONS_MODEL=auto

# SiliconFlow (https://api.siliconflow.com/v1 — the international endpoint; the
# .cn endpoint rejects the same key with 401 "Token is invalid").
# Verified 2026-11-10: key authenticates (79-model catalogue) but the account
# balance is 0, so every chat answers 402 "balance is insufficient" → provider
# out for the run. It starts working as soon as the account is topped up.
SILICONFLOW_API_KEY=
SILICONFLOW_BASE_URL=https://api.siliconflow.com/v1
SILICONFLOW_MODEL=auto

# Model used by the generic-compatible provider and the translator fallback
ALP_LLM=auto

# Generic OpenAI-compatible provider
LLM_API_URL=
LLM_API_KEY=
LLM_MODEL=auto

# OpenRouter (auto picks only zero-price ":free" models)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=auto

# Mistral (final fallback)
MISTRAL_API_KEY=
MISTRAL_MODEL=auto

# NVIDIA NIM (auto = meta/llama-3.2-90b-vision-instruct, the only model that
# answers on this key; 40 s per-call timeout; keep the key in a secret manager)
NVIDIA_API_KEY=
NVIDIA_MODEL=auto

# Low-priority fallbacks (each OFF without its key; small per-run caps,
# override with AI_ROUTER_RPD_<NAME>). Full order:
# Groq → Gemini → LLM7 → Mistral → OpenRouter → Cohere → Pollinations
# → HuggingFace → NVIDIA → (generic) → SiliconFlow.
# Cohere trial key: 20 RPM, 1,000 calls/month → capped at 30 calls per run.
COHERE_API_KEY=
COHERE_MODEL=auto
# LLM7.io (https://api.llm7.io/v1; free token 1 RPS / 100k tokens per day;
# 4th in the order, ≤60 calls per run, 45 s per-call timeout)
LL7_API_KEY=
LLM7_MODEL=auto
# HuggingFace Inference Providers router (tiny free credit → 15 calls per run)
HUGGINGFACE_API_KEY=
HUGGINGFACE_MODEL=auto
# Gemini per-call timeout (a hung model rotates to the next one):
# AI_ROUTER_TIMEOUT_GEMINI=25
# AI_ROUTER_TIMEOUT_LLM7=45
# AI_ROUTER_TIMEOUT_NVIDIA=40

# AI time budget per stage (default 70% of ALP_STAGE_TIMEOUT); after it the
# router returns None and callers take their deterministic / fail-closed path.
# ALP_AI_STAGE_BUDGET=630

# Optional news / search helpers (each OFF without its key; 401/402/403/429
# turns one off for the rest of the run, other failures only log):
#   NEWSDATA_API_KEY  NewsData.io India news in collection (3 credits per run; free 200/day)
#   GNEWS_API_KEY     GNews v4 India top-headlines + search (4 requests per run; free 100/day)
#   SERPER_API_KEY    Google search/news corroboration in stage 04 (25 calls per run)
#   JINA_API_KEY      Jina Reader article text when direct fetch fails (20 calls per run;
#                     402 no balance → keyless reader fallback)
JINA_API_KEY=
NEWSDATA_API_KEY=
GNEWS_API_KEY=
SERPER_API_KEY=
# ALP_NEWS_APIS=1               # 0 = never call GNews/NewsData in collection
# ALP_GNEWS_MAX_CALLS=4
# ALP_NEWSDATA_MAX_CALLS=3
# ALP_SERPER_MAX_CALLS=25
# ALP_JINA_MAX_CALLS=20

# --- AI router tuning (pipeline/ai_router.py) ---
AI_ROUTER_TIMEOUT=60                 # per-provider request timeout (s)
AI_ROUTER_MAX_CALLS_PER_HOUR=500     # global call budget
AI_ROUTER_CACHE_SIZE=1000            # LRU response cache entries
AI_ROUTER_DISABLED=0                 # 1 = never call providers (tests / offline)

# -----------------------------------------------------------------------------
# 🟢 PIPELINE BEHAVIOR
# -----------------------------------------------------------------------------

# --- Fact Verification (agents/04_fact_verification.py) ---
# Minimum confidence score (0.0–1.0) for an article to pass verification.
# Lower = more permissive (more articles pass, but noise possible)
# Recommended: 0.25–0.4
MIN_CONFIDENCE_THRESHOLD=0.3

# Minimum number of verified items required to proceed.
# If fewer than this pass, the job fails.
MIN_VERIFIED_COUNT=1

# Disable LLM verification entirely (use heuristics only)
#   1 = heuristics only (fast, free)
#   0 = use LLM if configured
ALP_DISABLE_LLM_VERIFY=0

# Disable English content polish step
#   1 = never call polish API
ALP_DISABLE_POLISH=0

# --- Translation (pipeline/ai_translator.py) ---
# Strict translation mode — if AI translation fails, do NOT ship dictionary Hindi.
#   1 = fail-closed (item is flagged needs_review, not silently accepted)
#   0 = allow dictionary fallback with needs_review flag
ALP_TRANSLATION_STRICT=0

ALP_TRANSLATION_TIMEOUT=45           # per-provider timeout (s)
ALP_TRANSLATION_MAX_RETRIES=2        # retries per provider
ALP_TRANSLATION_CACHE_SIZE=2000      # LRU cache entries
ALP_TRANSLATION_AUTO_REPAIR=1        # append a genuinely-dropped acronym instead of rejecting the line
ALP_TRANSLATION_MAX_ACRONYM_REPAIRS=2 # max acronyms appended per line (0 = never repair)

# ---- MCQ variety (cross-edition memory) -------------------------------------
ALP_MCQ_HISTORY=1                      # skip questions a recent edition already printed
ALP_MCQ_HISTORY_DAYS_CONCEPT=30        # window for concept/static questions (days)
ALP_MCQ_HISTORY_DAYS_NEWS=14           # window for news-derived questions (days)
ALP_MCQ_HISTORY_MAX_ENTRIES=4000       # cap on remembered question fingerprints

# Allow publishing editions that still carry a fallback translation.
#   0 (default) = block publish unless every item passed review
ALP_ALLOW_FALLBACK_TRANSLATION=0

# --- Claim verifier (pipeline/claim_verifier.py) ---
ALP_CLAIM_FETCH_TIMEOUT=20           # per-request source fetch timeout (s)
ALP_CLAIM_MAX_BYTES=2000000          # source response size cap (bytes)
ALP_CLAIM_ENABLE_JINA=1              # 1 = Jina Reader fallback when direct fetch fails

# -----------------------------------------------------------------------------
# 🟢 COLLECTION BEHAVIOR (pipeline/01_source_fetch.py — canonical collector)
# -----------------------------------------------------------------------------
# Per-feed request timeout (seconds). Legacy alias: REQUEST_TIMEOUT.
ALP_FEED_TIMEOUT=20

# Similarity threshold above which two articles are treated as the same event.
DEDUP_SIMILARITY_THRESHOLD=0.85

# (Retired pipeline/collector.py knobs are COLLECT_* only — they do not affect
#  the canonical collector above: COLLECT_REQUEST_TIMEOUT, COLLECT_RETRIES,
#  COLLECT_MAX_WORKERS, COLLECT_MAX_ITEMS, COLLECT_MIN_ITEMS, COLLECT_DEADLINE_S,
#  COLLECT_MAX_RESPONSE_BYTES, COLLECT_KEEP_UNDATED, COLLECT_USER_AGENT,
#  COLLECT_MAX_ENTRIES_PER_FEED, COLLECT_MAX_HTML_LINKS_PER_SOURCE,
#  COLLECT_ENFORCE_CORE_COVERAGE, COLLECT_MIN_CORE_COVERAGE,
#  COLLECT_ENABLE_TIER5_FALLBACK. See pipeline/collector.py.)

# --- Standalone verifier (pipeline/verify.py — not in the stage list) ---
VERIFY_TIMEOUT=15
VERIFY_WORKERS=8
VERIFY_DEADLINE_S=300

# --- Weekly / monthly editors ---
WEEKLY_LOOKBACK_DAYS=7
WEEKLY_MAX_ARTICLES=40

# --- Model orchestrator (agents/00_model_orchestrator.py) ---
# 1 = skip live provider health-check calls at startup
ORCHESTRATOR_SKIP_HEALTHCHECK=0

# -----------------------------------------------------------------------------
# 🟢 ORCHESTRATOR
# -----------------------------------------------------------------------------
# Timeout per stage (seconds). Kill hung processes.
#   Legacy alias: STAGE_TIMEOUT_SECONDS
ALP_STAGE_TIMEOUT=900

# Max retries per stage (transient failures).
#   Legacy alias: MAX_STAGE_RETRIES
ALP_MAX_RETRIES=2

# Base delay (seconds) for exponential backoff between retries.
ALP_RETRY_BASE_DELAY=5

# Watchdog: hours after which a RUNNING job is considered stuck.
#   Legacy alias: WATCHDOG_STUCK_HOURS
ALP_RUNNING_STUCK_HOURS=6

# Watchdog: how far back to look for recently failed jobs (hours)
ALP_FAILED_LOOKBACK_HOURS=72

# Watchdog: max automatic recovery attempts before requiring manual action
ALP_RECOVERY_MAX_ATTEMPTS=6

# Logging verbosity: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# -----------------------------------------------------------------------------
# 🟢 GENERATED PDF / QA
# -----------------------------------------------------------------------------
PDF_PAGE_SIZE=A4                     # A4 | LETTER
PDF_MARGIN_PT=40
PDF_TITLE=Current Affairs
PDF_MAX_MCQS=15
PDF_FONT_DIR=src/fonts

# Allow generating an unshaped-Devanagari PDF in dev only. NEVER set in prod.
ALP_ALLOW_UNSHAPED_DEV_PDF=0

# Release-booklet page range. A PDF outside this range fails before Telegram
# publishing. Lower the minimum only for a local dry-run diagnostic.
PDF_QA_MIN_PAGES=15
PDF_QA_MAX_PAGES=45
PDF_QA_MIN_HINDI_PCT=5.0             # % devanagari chars required in text layer
PDF_QA_MIN_MCQ_COUNT=10
PDF_QA_STRICT=0                      # 1 = fail on warnings
PDF_QA_RENDER_CHECK=0                # 1 = render pages to pixels for blank-detection

# Minimum independently verified stories for a publishable daily study pack.
ALP_MIN_DAILY_NEWS=15

# -----------------------------------------------------------------------------
# 🟢 MEMORY & STATE
# -----------------------------------------------------------------------------
# Override importance-memory file location
# ALP_MEMORY_PATH=state/importance_memory.json
ALP_MEMORY_MAX_ENTRIES=2000

# Override published-events ledger location / cap
# ALP_PUBLISHED_PATH=state/published_events.json
ALP_PUBLISHED_MAX_ENTRIES=10000

# Override source-health file location
# ALP_SOURCE_HEALTH_PATH=state/source_health.json

# Root directory override (used by pipeline/state.py)
# ALP_ROOT=/path/to/repo

# -----------------------------------------------------------------------------
# Content target, reserves and news photos (defaults shown; all optional)
# -----------------------------------------------------------------------------
# Next-best stories kept by selection for backfill (default max(8, target/2))
# ALP_SELECTION_RESERVES=8
# Max share of the edition from one publisher (0-1)
# ALP_MAX_PER_SOURCE_PCT=0.4
# Drop tenders/bid notices, editorials, reviews, videos, live blogs (0 = keep)
# ALP_FILTER_NON_NEWS=1
# Spare stories prepared by the content editor for MCQ-driven backfill
# ALP_CONTENT_SPARES=3
# LLM attempts per story MCQ (retried with the validator's rejection reasons)
# ALP_MCQ_LLM_ATTEMPTS=3
# Accept undated items of OFFICIAL feeds when the feed's own date is in window
# ALP_ACCEPT_FEED_DATED_OFFICIAL=1
# News photos in the PDF (0 = off), max photos, inline/gallery toggles
# ALP_PDF_IMAGES=1
# ALP_PDF_MAX_IMAGES=8
# ALP_PDF_INLINE_PHOTOS=1
# ALP_PDF_GALLERY=1
# ALP_PDF_GALLERY_MIN=3
# ALP_IMAGE_MIN_WIDTH=400
# ALP_IMAGE_MAX_WIDTH=1000
# ALP_IMAGE_JPEG_QUALITY=75
# ALP_IMAGE_MAX_BYTES=6000000
# Warn when the PDF prints fewer than 3 source URLs (public PDFs print none)
# PDF_QA_EXPECT_SOURCE_URLS=0

# -----------------------------------------------------------------------------
# 🟢 TESTING / DEVELOPMENT ONLY
# -----------------------------------------------------------------------------
# Dry-run mode — skip actual Telegram publishing
DRY_RUN=0

# Manual, operator-approved correction of an already-published edition.
# Scheduled workflows keep this off. Does NOT bypass uncertain sends.
ALP_ALLOW_EDITION_REVISION=0

# =============================================================================
# GitHub Actions Setup
# =============================================================================
# Repository Secrets (Settings → Secrets → Actions):
#
#   TELEGRAM_BOT_TOKEN        ← required for publishing
#   TELEGRAM_CHAT_ID          ← required for publishing
#   ADMIN_ID                  ← required for watchdog alerts
#   GROQ_API_KEY / GEMINI_API_KEY / LL7_API_KEY /
#   MISTRAL_API_KEY / OPENROUTER_API_KEY / COHERE_API_KEY /
#   HUGGINGFACE_API_KEY / NVIDIA_API_KEY / POLLINATIONS_API_KEY /
#   SILICONFLOW_API_KEY                   ← optional AI providers
#   NEWSDATA_API_KEY / GNEWS_API_KEY / SERPER_API_KEY / JINA_API_KEY
#                                                 ← optional news / search helpers
#   Check them all: Actions → "Verify API keys" → Run workflow
#   (or locally: python scripts/verify_keys.py)
#
# Non-sensitive behaviour vars can be Repository Variables instead.
# =============================================================================

# ---------------------------------------------------------------------------
# Discovery + auxiliary AI provider keys (section added 2026-11-03)
# REAL VALUES LIVE IN GITHUB ACTIONS SECRETS ONLY — never commit actual keys.
# Active entries below are read by code/workflows today; RESERVE entries are
# stored in Secrets awaiting wiring, so they stay commented (repo policy:
# .env.example documents only names the code actually reads).
# ---------------------------------------------------------------------------
# serper.dev Google Search API — primary-source discovery (pipeline/discovery_api.py)
SERPER_API_KEY=
# gnews.io v4 search API — news discovery, bypasses GNews AES-link decoding
GNEWS_API_KEY=
# Numeric Telegram channel id (e.g. -1001234567890); TELEGRAM_CHAT_ID may hold @username
TELEGRAM_CHANNEL_ID=
# --- RESERVE keys (already in GitHub Secrets; uncomment locally when wiring lands) ---
# COHERE_API_KEY=         # future router provider slot
# HUGGINGFACE_API_KEY=    # IndicTrans2 Hindi / hub model downloads
GEMINI_API_KEY_1=       # rotation reserve (GEMINI_API_KEY is the active one)
GEMINI_API_KEY_2=       # rotation reserve
GEMINI_API_KEY_3=       # rotation reserve (AIza-classic, verified 2026-11-10)
GEMINI_API_KEY_4=       # rotation reserve (verified 2026-11-10)
GEMINI_API_KEY_5=       # rotation reserve (verified 2026-11-10)
GEMINI_API_KEY_6=       # rotation reserve (verified 2026-11-10)
GEMINI_API_KEY_7=       # rotation reserve (verified 2026-11-10)
GROQ_API_KEY_1=         # rotation reserve (GROQ_API_KEY is the active one; verified 2026-11-10)
GROQ_API_KEY_2=         # rotation reserve (verified 2026-11-10)
# LL7_API_KEY=            # unnamed service, stored inert
